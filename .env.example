# Copy to .env.local for local development. Never commit real values.

# Supabase (Phase 1, step 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application-layer encryption for ledger entries and vault (AES-256-GCM).
# 32 random bytes, base64. Generate with: openssl rand -base64 32
LEDGER_ENCRYPTION_KEY=

# Invite-only until the spec's legalReviewStatus no longer starts with DRAFT.
ALLOW_PUBLIC_SIGNUP=false

# Shown on the Tier 3 (documented proof) unlock page.
SUPPORT_EMAIL=
