{
  "name": "spouse-ledger",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run check:spec",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test \"tests/*.test.mjs\"",
    "check:spec": "node scripts/check-spec.mjs",
    "spec:lock": "node scripts/spec-lock.mjs",
    "build:worksheet": "python3 scripts/build_worksheet_from_spec.py spec/ledger-spec.json public/worksheet/spouse-ledger-worksheet.pdf",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
